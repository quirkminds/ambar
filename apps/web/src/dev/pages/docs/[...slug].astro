---
import { getCollection, render } from "astro:content";
import DocsLayout from "../../components/docs-layout.astro";
import { docTitle } from "../../lib/docs.ts";

export const prerender = false;

const { slug = "" } = Astro.params;

const docs = await getCollection("engineeringDocs");

const docId = slug.replace(/\.md$/i, "").toLowerCase();

const doc = docs.find((entry) => entry.id === docId);

if (!doc) {
  return new Response("Documentation page not found", { status: 404 });
}

if (doc.id === "readme") return Astro.redirect("/dev/docs", 308);

const { Content, headings } = await render(doc);
---

<DocsLayout title={docTitle(doc)} docs={docs} activeId={doc.id} headings={headings}>
  <Content />
</DocsLayout>
